# Backend (FastAPI) — every setting backend/backend/core/config.py reads.
# Local dev reads the repo-root .env (config.py: env_file=["../.env", ".env"]
# relative to the backend/ working directory); this file documents the
# backend's share of it. Required = no default in config.py.

# --- Application ---
ENVIRONMENT=local                      # local | test | staging | production — outside local/test the boot checks below apply
APP_VERSION=0.1.0
# HS256 secret for guest (candidate) JWTs. Outside local/test the shipped default is refused and >= 32 chars is required.
SECRET_KEY=change-me
# Shared secret the agent worker presents on /internal/* calls. REQUIRED for the agent to talk to the backend.
AGENT_API_SECRET=change-me

# --- Supabase (Auth + Storage) --- REQUIRED
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SECRET_KEY=<service-role-key>           # server-only, never ship to the frontend
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=                        # optional; browser key, not read by the backend
SUPABASE_JWT_ALGORITHMS=["ES256", "RS256"]       # JSON list
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_TIMEOUT_SECONDS=30
STORAGE_RETRY_ATTEMPTS=2                         # retries on transport errors (not on 4xx/5xx)

# --- Guest (candidate) JWTs ---
GUEST_JWT_ALGORITHM=HS256
GUEST_JWT_TTL_HOURS=24

# --- Database --- REQUIRED (asyncpg DSN; Supabase pooler string in the hosted setup)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
RUN_MIGRATIONS_ON_START=false                    # container entrypoint runs alembic first when true (single-instance deploys only)

# --- Provider selectors (backend/backend/providers/factory.py) — one value each today ---
REALTIME_PROVIDER=livekit
RECORDINGS_STORAGE_PROVIDER=s3                   # Cloudflare R2 via the S3-compatible adapter
RESUMES_STORAGE_PROVIDER=supabase
NOTIFICATIONS_PROVIDER=console                   # console = log invitations (default) | email = hand to EMAIL_PROVIDER
EMAIL_PROVIDER=null                              # null = log + report not-sent; real vendor adapter is P1 (CURRENT_DECISIONS.md)

# --- LiveKit (room tokens + egress) --- REQUIRED outside local/test
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=360                    # candidate room token lifetime (SDK default)
LIVEKIT_API_TIMEOUT_SECONDS=10                   # server API calls (egress start/stop, room delete)
EGRESS_LAYOUT=speaker
EGRESS_START_RETRY_ATTEMPTS=10
EGRESS_START_RETRY_DELAY_SECONDS=1.0
RECORDING_PATH_TEMPLATE=interviews/{session_id}/{timestamp}.mp4

# --- Cloudflare R2 (S3-compatible) — interview recordings (docs/proctoring-architecture.md) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
RECORDING_URL_TTL_SECONDS=3600                   # presigned GET URL lifetime for HR
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3

# --- CVs (Supabase Storage) ---
RESUMES_BUCKET=resumes
MAX_RESUME_BYTES=5242880                         # 5 MB

# --- Groq (question generation, evaluation, CV extraction) ---
LLM_PROVIDER=groq                                # only adapter today (H1-B factory selector)
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com                  # origin only; the SDK appends /openai/v1
GROQ_MODEL=llama-3.3-70b-versatile               # generation / evaluation / invitation drafts
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant       # CV -> profile extraction
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# --- Interview lifecycle ---
AGENT_LEASE_MINUTES=10                     # agent's claim on a session; renewed periodically
DISCONNECT_SWEEP_INTERVAL_SECONDS=120      # how often the idle-disconnect sweep runs
DISCONNECT_AUTO_FINALIZE_MINUTES=10        # idle-in-DISCONNECTED minutes before auto-finalization
ADMIN_TEST_CANDIDATE_EMAIL=admin_tester@path2hire.local
ADMIN_TEST_CANDIDATE_NAME=Admin Tester

# --- Tunables ---
SUGGESTED_EVIDENCE_SUFFICIENCY_FLOOR=0.5   # HR dashboard "suggested candidates" threshold
BACKEND_CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174"]

# --- Observability (H3) ---
LOG_FORMAT=auto                            # json | text | auto (auto = text when ENVIRONMENT is local/test, json otherwise)
LOG_LEVEL=INFO
METRICS_ENABLED=true                       # exposes GET /metrics (Prometheus text) and the request/provider/sweep counters
