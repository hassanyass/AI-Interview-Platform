# Frontend (Vite). Only VITE_* variables reach the browser bundle. Read in
# one place, src/config.ts; the first three are REQUIRED — a build without
# them shows a "Configuration error" screen naming what is missing.

VITE_API_BASE_URL=http://127.0.0.1:8001       # backend base URL, absolute http(s)
VITE_API_TIMEOUT_MS=30000                     # default per-request timeout; the CV upload uses 120000
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Proctoring face monitor (features/interview-session/useFaceDetectionMonitor.ts) ---
VITE_FACE_DETECTION_INTERVAL_SECONDS=4
VITE_HEAD_DOWN_CONFIRM_THRESHOLD=3
VITE_HEAD_DOWN_PITCH_THRESHOLD_DEGREES=25
# Head-pose angle logging: on in dev builds, off in production builds; true/false overrides (docs/CURRENT_DECISIONS.md)
# VITE_HEAD_POSE_DEBUG=
