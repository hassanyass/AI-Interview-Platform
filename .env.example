# -----------------------------------------------------------------------------
# AI INTERVIEW PLATFORM - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# --- APPLICATION ---
# Environment: local, staging, production
ENVIRONMENT=local

# --- SUPABASE ---
# Supabase project URL
SUPABASE_URL=https://<project-id>.supabase.co
# Supabase Publishable/Anon Key (browser-safe)
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# Supabase Secret/Service Role Key (backend-only, NEVER expose to frontend)
SUPABASE_SECRET_KEY=<your-secret-key>
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json

# --- DATABASE ---
# PostgreSQL connection string (use Supavisor pooler string for backend connection)
DATABASE_URL=postgresql+asyncpg://postgres.<project-id>:<password>@<region>.pooler.supabase.com:6543/postgres

# --- LIVEKIT ---
# LiveKit Cloud or local instance URL (e.g., wss://your-project.livekit.cloud)
LIVEKIT_URL=wss://<project>.livekit.cloud
# LiveKit API Key
LIVEKIT_API_KEY=<your-api-key>
# LiveKit API Secret (NEVER expose to frontend)
LIVEKIT_API_SECRET=<your-api-secret>

# --- GROQ (GPT-OSS) ---
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama3-70b-8192

# --- GROQ TTS MULTI-KEY ROTATION (agent/agent/interview/groq_key_rotator.py) ---
# Optional. Only needed if TTS_PROVIDER=groq. Groq's free-tier TTS quota is
# a hard per-key, per-day ceiling (confirmed live — see
# docs/tts-provider-switching.md) — provisioning several keys lets the
# agent rotate to the next one automatically, immediately, the moment the
# current one hits its daily limit, instead of the whole voice going
# silent. Fill in as many as you have (1 is fine, up to 20 supported) —
# gaps/missing numbers are fine, only non-empty ones are used. If none of
# these are set, GROQ_API_KEY above is used as the only key (no rotation).
GROQ_API_KEY_1=<groq-api-key-1>
GROQ_API_KEY_2=<groq-api-key-2>
GROQ_API_KEY_3=<groq-api-key-3>
GROQ_API_KEY_4=<groq-api-key-4>
GROQ_API_KEY_5=<groq-api-key-5>
GROQ_API_KEY_6=<groq-api-key-6>
GROQ_API_KEY_7=<groq-api-key-7>

# --- STT (Speech-to-Text) ---
STT_PROVIDER=livekit
STT_MODEL=
STT_LANGUAGE=en

# --- LLM ---
LLM_PROVIDER=openai
# OpenAI API Key if using OpenAI directly
OPENAI_API_KEY=<your-openai-api-key>
# Recommended Model
LLM_MODEL=gpt-4o

# --- TTS (Text-to-Speech) ---
TTS_PROVIDER=livekit
TTS_MODEL=
TTS_LANGUAGE=en
# When Groq returns HTTP 429, pause TTS requests while keeping transcript/UI active.
TTS_429_COOLDOWN_SECONDS=30
TTS_MAX_RETRIES=2
TTS_429_RETRY_DELAY_SECONDS=3

# --- INTERVIEW CONFIGURATION ---
DEFAULT_MAX_DURATION_MINUTES=45
DEFAULT_LANGUAGE=en

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
