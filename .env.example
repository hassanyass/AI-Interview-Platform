# -----------------------------------------------------------------------------
# Himma / Path2Hire — local development environment (copy to .env)
# -----------------------------------------------------------------------------
# One file, read by both services in local dev:
#   backend  — backend/backend/core/config.py  (env_file "../.env" from backend/)
#   agent    — agent/agent/main.py             (load_dotenv on this file, then agent/.env)
# The frontend reads frontend/.env (VITE_* only).
#
# Per-service references listing exactly what each one reads, with defaults:
#   backend/.env.example   agent/.env.example   frontend/.env.example
# Test suites never use DATABASE_URL below — conftest.py substitutes
# TEST_DATABASE_URL (default: the docker-compose `postgres-test` service).

# --- Application ---
ENVIRONMENT=local
SECRET_KEY=change-me                     # guest-JWT HS256 secret (backend)
AGENT_API_SECRET=change-me               # shared by backend (/internal/*) and agent
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# --- Supabase ---
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<service-role-key>
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json

# --- Database (backend) ---
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/himma_test

# --- LiveKit ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 recordings (backend) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile       # backend generation/evaluation model
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
LLM_MODEL=                               # agent live-interview model
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional TTS key rotation (agent): GROQ_API_KEY_1 … GROQ_API_KEY_20
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- TTS (agent) ---
TTS_PROVIDER=groq                        # groq | azure
GROQ_TTS_ENGLISH_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_ENGLISH_VOICE=troy
GROQ_TTS_ARABIC_MODEL=canopylabs/orpheus-arabic-saudi
GROQ_TTS_ARABIC_VOICE=abdullah
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_ENGLISH_VOICE=en-US-AvaNeural
AZURE_TTS_ARABIC_VOICE=ar-SA-HamedNeural

# --- Backend provider selectors (backend/backend/providers/factory.py) ---
LLM_PROVIDER=groq
REALTIME_PROVIDER=livekit
RECORDINGS_STORAGE_PROVIDER=s3
RESUMES_STORAGE_PROVIDER=supabase
NOTIFICATIONS_PROVIDER=console           # console | email (email -> EMAIL_PROVIDER, still inert with 'null')
EMAIL_PROVIDER=null

# --- Tunables (all optional; defaults shown — full list per service in backend/.env.example, agent/.env.example) ---
SUGGESTED_EVIDENCE_SUFFICIENCY_FLOOR=0.5
DISCONNECT_AUTO_FINALIZE_MINUTES=10
AGENT_LEASE_MINUTES=10
DISCONNECT_SWEEP_INTERVAL_SECONDS=120
GUEST_JWT_TTL_HOURS=24
LIVEKIT_TOKEN_TTL_MINUTES=360
RECORDING_URL_TTL_SECONDS=3600
GROQ_TIMEOUT_SECONDS=30
WAITING_ROOM_TIMEOUT_SECONDS=300
VAD_MIN_SILENCE_DURATION_SECONDS=0.85
STT_ENDPOINT_DELAY_SECONDS=0.8
VERBAL_FOLLOWUP_TIME_BONUS_SECONDS=120
LEASE_RENEWAL_INTERVAL_SECONDS=300
# AGENT_STATE_DIR=/var/lib/himma-agent    # containers: writable volume for key-rotation state + TTS cache
BACKEND_CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174"]
