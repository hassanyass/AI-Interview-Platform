# Agent worker (livekit-agents) — every variable agent/agent/config.py
# (AgentSettings) declares, plus the one the frozen controller reads itself.
# At job start the worker loads the repo-root .env (override=True) and then
# agent/.env (fills gaps only) — main._load_env(); settings are read after.

# --- REQUIRED (agent/agent/main.py required_vars) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_API_KEY=                               # LLM + STT + TTS (groq) — also the fallback TTS key when no GROQ_API_KEY_n is set
AGENT_API_SECRET=                           # must equal the backend's AGENT_API_SECRET
BACKEND_INTERNAL_URL=http://127.0.0.1:8001  # backend base URL for /internal/*  (compose: http://backend:8001)

# --- LLM ---
LLM_MODEL=                                  # Groq model id; REQUIRED — checked with the other required vars before the session is touched
LLM_TIMEOUT_SECONDS=30                      # bounds a turn: a stalled model yields the localized fallback line instead of holding the turn lock
LLM_MAX_RETRIES=1

# --- Backend (/internal/*) client ---
BACKEND_TIMEOUT_SECONDS=10
BACKEND_RETRY_ATTEMPTS=3                    # transport errors / 5xx only; failed messages, events, checkpoints are parked and replayed
LEASE_ERROR_SHUTDOWN_AFTER=3                # consecutive renewal transport errors before the worker stops driving the session

# --- Room / data-channel guards ---
STT_RESTART_MAX=2                           # rebuild a crashed STT stream this many times, then give up for the session
UI_COMMAND_MAX_BYTES=16384

# --- STT (Groq Whisper) ---
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_ENDPOINT_DELAY_SECONDS=0.8              # floor 0.25

# --- TTS ---
TTS_PROVIDER=groq                           # groq | azure   (code default is azure; .env sets groq)
# Groq TTS
GROQ_TTS_ENGLISH_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_ENGLISH_VOICE=troy
GROQ_TTS_ARABIC_MODEL=canopylabs/orpheus-arabic-saudi
GROQ_TTS_ARABIC_VOICE=abdullah
# Optional Groq TTS key rotation (agent/agent/interview/groq_key_rotator.py): GROQ_API_KEY_1 … GROQ_API_KEY_20
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Azure TTS (REQUIRED when TTS_PROVIDER=azure; the LiveKit azure plugin reads the first two itself)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_ENGLISH_VOICE=en-US-AvaNeural
AZURE_TTS_ARABIC_VOICE=ar-SA-HamedNeural

# --- Interview pacing ---
WAITING_ROOM_TIMEOUT_SECONDS=300            # floor 1.0
VAD_MIN_SILENCE_DURATION_SECONDS=0.85       # floor 0.55
VERBAL_FOLLOWUP_TIME_BONUS_SECONDS=120      # floor 0 — read directly by interview/controller.py (frozen file), not via AgentSettings
LEASE_RENEWAL_INTERVAL_SECONDS=300          # how often the worker renews its session lease

# --- Worker process (WorkerOptions) ---
AGENT_NAME=                                 # LiveKit agent_name for explicit dispatch; empty = automatic dispatch
JOB_MEMORY_LIMIT_MB=0                       # 0 = SDK default (disabled)
JOB_MEMORY_WARN_MB=0                        # 0 = SDK default
AGENT_STATE_DIR=                            # Groq key-rotation state files; default = the agent/ directory. Point at a writable volume in containers.
TTS_CACHE_DIR=                              # synthesised-audio cache; default = <AGENT_STATE_DIR>/.tts_cache
